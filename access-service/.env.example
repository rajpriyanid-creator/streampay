# Copy to .env and edit.
PORT=4001
RPC_URL=http://127.0.0.1:8545
# REQUIRED: address printed by the Deploy script (or set in ../manifests/<NETWORK>.json)
SETTLEMENT_ADDRESS=
NETWORK=local
CORS_ORIGIN=http://localhost:3000
# Optional: enables /api/vouchers and /api/session/latest-voucher/:id (send "Authorization: Bearer <token>")
ADMIN_TOKEN=
STREAM_IDS=monad-keynote-hd
MIN_UNIT_PRICE=10000
